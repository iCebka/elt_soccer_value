### AL ###
#Template for AL projects for Dynamics 365 Business Central
#launch.json folder
.vscode/
#Cache folder
.alcache/
#Symbols folder
.alpackages/
#Snapshots folder
.snapshots/
#Testing Output folder
.output/
#Extension App-file
*.app
#Rapid Application Development File
rad.json
#Translation Base-file
*.g.xlf
#License-files
*.bclicense
*.flf
#Test results file
TestResults.xml

# Local configuration and credentials
.env
.env.*
!.env.example
# Defense in depth for credential files accidentally copied into the workspace.
*.p8
*.pem
*.key

# Python/test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
htmlcov/
.coverage

# Ingestion work files
*.csv.gz
*.ndjson
tmp/
work/
