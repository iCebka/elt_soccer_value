# Copy to .env. Never commit the resulting file or its credentials.
POSTGRES_DB=kestra
POSTGRES_USER=kestra
POSTGRES_PASSWORD=replace-with-a-long-random-password

KESTRA_PORT=8080
# Kestra 2.x requires a valid email address and a strong password for basic auth.
KESTRA_USERNAME=admin@example.com
KESTRA_PASSWORD=ReplaceThis123!

SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_USER=TRANSFERMARKT_LOADER
SNOWFLAKE_ROLE=TRANSFERMARKT_INGEST_ROLE
SNOWFLAKE_WAREHOUSE=INGEST_WH
SNOWFLAKE_DATABASE=FOOTBALL
SNOWFLAKE_BRONZE_SCHEMA=BRONZE

SNOWFLAKE_AUTH_METHOD=password
SNOWFLAKE_PASSWORD=

# dbt/Silver. dev/test add their target prefix; prod writes to the exact schemas below.
# Kestra derives its internal ENV_* aliases from these values in Compose; do not
# duplicate those aliases in .env and never commit the populated .env file.
DBT_TARGET=dev
DBT_DEV_SCHEMA=DBT_DEV
DBT_TEST_SCHEMA=DBT_TEST
SNOWFLAKE_STAGING_SCHEMA=STAGING
SNOWFLAKE_SILVER_SCHEMA=SILVER
# Image executed by Kestra's pinned Docker Run plugin; keep aligned with Compose.
DBT_IMAGE=transfermarkt-dbt:1.12.5-snowflake-1.12.1

