# Copy to .env. Never commit the resulting file or its credentials.
POSTGRES_DB=kestra
POSTGRES_USER=kestra
POSTGRES_PASSWORD=replace-with-a-long-random-password

KESTRA_PORT=8080
# Kestra 2.x requires a valid email address and a strong password for basic auth.
KESTRA_USERNAME=admin@example.com
KESTRA_PASSWORD=ReplaceThis123!

SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_USER=TRANSFERMARKT_LOADER
SNOWFLAKE_ROLE=TRANSFERMARKT_INGEST_ROLE
SNOWFLAKE_WAREHOUSE=INGEST_WH
SNOWFLAKE_DATABASE=FOOTBALL
SNOWFLAKE_BRONZE_SCHEMA=BRONZE

SNOWFLAKE_AUTH_METHOD=password
SNOWFLAKE_PASSWORD=

